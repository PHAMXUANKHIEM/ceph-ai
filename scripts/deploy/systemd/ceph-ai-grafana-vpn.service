[Unit]
Description=Ceph AI Grafana OpenVPN split tunnel
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ceph-ai/vpn/grafana.ovpn
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/sbin/openvpn --config /etc/ceph-ai/vpn/grafana.ovpn --dev cephvpn0 --dev-type tun --route-nopull --script-security 1 --auth-nocache --auth-retry none --connect-retry-max 1
ExecStopPost=/usr/bin/rm -f /run/ceph-ai-grafana-vpn/credentials
Restart=on-abnormal
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
