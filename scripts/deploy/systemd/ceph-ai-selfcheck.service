[Unit]
Description=Ceph AI host self-check (alerts straight to Telegram)
# Deliberately independent of the stack it watches: no After/Requires on
# ceph-ai-containers.service, so it also runs when the stack is down.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3.11 /root/ceph-ai/scripts/selfcheck/ceph_ai_selfcheck.py
# Self-heal restarts containers from here (podman restart). Their new conmon
# monitor starts inside this unit's cgroup; the default KillMode=control-group
# killed it when the run ended or timed out, leaving the restarted container
# stuck in "Stopping" (watcher, remediation-watcher, telegram-ai on
# 08/10/2026). Only stop the selfcheck process itself.
KillMode=process
# Room for a few `podman restart -t 30` in one run.
TimeoutStartSec=300
Nice=5
