[Unit]
Description=Ceph AI RabbitMQ network hardening
After=local-fs.target
Before=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ceph-ai-firewall
RemainAfterExit=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
