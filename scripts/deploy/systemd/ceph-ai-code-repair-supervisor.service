[Unit]
Description=Ceph AI Code Repair Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ceph-ai
NoNewPrivileges=yes
# Repair may edit/test isolated worktrees, but an unscanned candidate must
# never push, replace or promote the immutable production artifact.
Environment=CODE_REPAIR_PUSH=false
Environment=CODE_REPAIR_DEPLOY_STAGING=false
Environment=CODE_REPAIR_PROMOTE_MAIN=false
ExecStart=/root/ceph-ai/.venv/bin/python -m worker.code_repair_supervisor
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=append:/var/log/ceph-ai-code-repair-supervisor.log
StandardError=append:/var/log/ceph-ai-code-repair-supervisor.log

[Install]
WantedBy=multi-user.target
