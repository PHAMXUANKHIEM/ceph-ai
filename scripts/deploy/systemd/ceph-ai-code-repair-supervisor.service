[Unit]
Description=Ceph AI Code Repair Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ceph-ai
ExecStart=/root/ceph-ai/.venv/bin/python -m worker.code_repair_supervisor
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=append:/var/log/ceph-ai-code-repair-supervisor.log
StandardError=append:/var/log/ceph-ai-code-repair-supervisor.log

[Install]
WantedBy=multi-user.target
