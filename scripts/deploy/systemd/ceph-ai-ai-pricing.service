[Unit]
Description=Refresh Ceph AI model pricing snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/ceph-ai
ExecStart=/root/ceph-ai/.venv/bin/python -m scripts.update_ai_pricing
Environment=AI_COST_PRICING_CACHE_PATH=/var/lib/ceph-ai/config/ai-pricing.json
NoNewPrivileges=yes
PrivateTmp=yes
