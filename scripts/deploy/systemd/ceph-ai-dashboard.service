[Unit]
Description=Ceph AI Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ceph-ai
NoNewPrivileges=yes
Environment=CEPH_AI_RUNTIME_DIR=/run/ceph-ai
RuntimeDirectory=ceph-ai
RuntimeDirectoryPreserve=yes
ExecStart=/root/ceph-ai/.venv/bin/python -m uvicorn dashboard.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=append:/var/log/ceph-ai-dashboard.log
StandardError=append:/var/log/ceph-ai-dashboard.log

[Install]
WantedBy=multi-user.target
