[Unit]
Description=RabbitMQ for Ceph AI (the existing "rabbitmq" container)
# The container keeps its node name and data volume; this unit only makes sure
# it is running after a host reboot, before the Ceph AI stack starts.
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/containers
Before=ceph-ai-containers.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/podman start rabbitmq
ExecStop=/usr/bin/podman stop -t 30 rabbitmq
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
