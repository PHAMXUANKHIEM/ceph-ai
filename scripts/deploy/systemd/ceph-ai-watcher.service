[Unit]
Description=Ceph AI Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ceph-ai
Environment=CEPH_AI_RUNTIME_DIR=/run/ceph-ai
RuntimeDirectory=ceph-ai
RuntimeDirectoryPreserve=yes
ExecStart=/root/ceph-ai/.venv/bin/python -m watcher.main
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=append:/var/log/ceph-ai-watcher.log
StandardError=append:/var/log/ceph-ai-watcher.log

[Install]
WantedBy=multi-user.target
