#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$script_dir"

# Never build or load application source on a service restart. A production
# reboot must start the same approved digest, not a mutable tag or checkout.
python3 scripts/bootstrap_container_config.py
image_ref_file=/var/lib/ceph-ai/release-artifacts/current-image-ref
environment="$(python3 -c 'from dotenv import dotenv_values; print(dotenv_values("/var/lib/ceph-ai/config/.env").get("CEPH_AI_ENVIRONMENT", "development"))')"
if [ -f "$image_ref_file" ]; then
  IFS= read -r CEPH_AI_IMAGE < "$image_ref_file"
  if [[ ! "$CEPH_AI_IMAGE" =~ ^ghcr\.io/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$ ]]; then
    echo "Invalid approved image reference in $image_ref_file" >&2
    exit 4
  fi
  export CEPH_AI_IMAGE
elif [ "$environment" = production ]; then
  echo "Production refuses to start without an approved registry digest" >&2
  exit 4
fi

# This unit is the canonical owner for the compose services.  Leaving one of
# the legacy bare-metal services enabled starts a second Worker/Watcher against
# the same database and RabbitMQ queues, which can duplicate incident handling
# and overwrite the shared heartbeat.  Remediation Watcher is intentionally
# excluded because it has no compose counterpart.
for legacy_service in ceph-ai-worker.service ceph-ai-watcher.service ceph-ai-dashboard.service; do
  if systemctl cat "$legacy_service" >/dev/null 2>&1; then
    systemctl disable --now "$legacy_service"
  fi
done

# Code Repair is a separate host supervisor with an explicit writable
# checkout. Never recreate it as part of the immutable runtime stack.
services=("$@")
if [ "${#services[@]}" -eq 0 ]; then
  services=(dashboard-web telegram-ai full-executor watcher worker vault-monitor)
fi
for service in "${services[@]}"; do
  if [ "$service" = "code-repair" ]; then
    echo "Code Repair is not part of the production Compose runtime" >&2
    exit 4
  fi
done
podman stop ceph-ai_code-repair_1 >/dev/null 2>&1 || true

# Recreate processes from the approved image reference.
exec podman-compose up -d --force-recreate "${services[@]}"
