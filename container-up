#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$script_dir"

# Image creation is an explicit deploy step (`podman-compose build`).  Do not
# rebuild automatically on every systemd restart: the source tree is mounted
# for the controlled Telegram code-edit workflow, while a boot must be fast
# and deterministic.
python3 scripts/bootstrap_container_config.py

# Code Repair has two supported owners: the host systemd supervisor on a
# systemd deployment, or the compose service on a container-only deployment.
# Never start both: each supervisor opens its own DB pool and can duplicate
# repair work. The old combination also consumed enough PostgreSQL slots to
# prevent Dashboard startup.
services=("$@")
if systemctl is-active --quiet ceph-ai-code-repair-supervisor.service 2>/dev/null; then
  # If an old compose container exists, stop it before starting the host
  # supervisor-owned stack. Excluding the service from up alone does not
  # stop a previously running duplicate.
  podman-compose stop code-repair >/dev/null 2>&1 || true
  if [ "${#services[@]}" -eq 0 ]; then
    services=(dashboard-web telegram-ai full-executor watcher worker)
  else
    filtered=()
    for service in "${services[@]}"; do
      [ "$service" = "code-repair" ] || filtered+=("$service")
    done
    services=("${filtered[@]}")
    if [ "${#services[@]}" -eq 0 ]; then
      echo "Code Repair is owned by ceph-ai-code-repair-supervisor.service; nothing to start in compose." >&2
      exit 0
    fi
  fi
fi

exec podman-compose up -d "${services[@]}"
