# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# config/settings.py dùng extra="forbid" — nếu .env có biến THỪA không nằm
# trong Settings class, ứng dụng sẽ crash ngay lúc khởi động. Đừng thêm biến
# nào ngoài danh sách dưới đây; đừng xoá dòng nào (để trống giá trị nếu
# không dùng — hầu hết các mục CEPH_* là tuỳ chọn, để trống vẫn chạy được).

# --- Database & message queue ---
DATABASE_URL=sqlite:///./ceph_aiops.db
RABBITMQ_URL=amqp://guest:guest@localhost/

# --- Đăng nhập Dashboard (BẮT BUỘC đổi trước khi public ra ngoài) ---
# Cách tạo DASHBOARD_PASSWORD_HASH và SESSION_SECRET_KEY: xem README.md
# mục "3. Tạo mật khẩu đăng nhập Dashboard".
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET_KEY=

# --- SSH tới cụm Ceph (dùng chung cho Watcher lẫn Worker) ---
# Để trống toàn bộ mục này nếu chưa có cụm để giám sát — ứng dụng vẫn khởi
# động và chạy được, chỉ là Watcher chưa có gì để poll. Cấu hình sau qua
# trang Cài đặt cũng được, không bắt buộc phải điền ở đây.
SSH_KEY_PATH=
SSH_USER=root
CEPH_MON_NODES=
CEPH_MON_HOSTNAMES=
CEPH_EXEC_MODE=cephadm
CEPH_CONTAINER_NAME=
CEPH_KEYRING_PATH=/etc/ceph/ceph.client.admin.keyring
WATCHER_POLL_INTERVAL_SECONDS=15
TELEGRAM_INCIDENT_REMINDER_INTERVAL_SECONDS=3600
# Read-only Vitastor health checks used by Dashboard cache and Telegram alerts.
VITASTOR_POLL_INTERVAL_SECONDS=60

# --- Tuỳ chọn: node OSD/MGR/RGW (lấy log/CLI riêng — để trống nếu không cần) ---
CEPH_OSD_NODES=
CEPH_OSD_CONTAINER_NAME=
CEPH_MGR_NODES=
CEPH_RGW_NODES=
CEPH_RGW_CONTAINER_NAME=

# --- Tuỳ chọn: theo dõi hiệu năng Volume (RBD) cấp cho VM ---
# Danh sách pool RBD cần theo dõi, cách nhau bởi dấu phẩy (vd: vms,volumes).
# Để trống = tắt hoàn toàn tính năng này, không tốn thêm SSH nào.
CEPH_RBD_POOLS=

# --- Tuỳ chọn: đề xuất evacuate OSD dự đoán sắp hỏng (DeviceHealth) ---
# Chu kỳ quét `ceph device ls`/`ceph osd dump` (giây) — mặc định 1 giờ.
DEVICE_HEALTH_SCAN_INTERVAL_SECONDS=3600
# Thiết bị dự đoán hỏng trong vòng bao nhiêu ngày thì đề xuất evacuate.
DEVICE_HEALTH_EVACUATE_THRESHOLD_DAYS=7

# --- Tuỳ chọn: build server cho tính năng "Vá lỗi Ceph" (patch pipeline) ---
CEPH_PATCH_BUILD_NODE=
CEPH_PATCH_SOURCE_DIR=
CEPH_PATCH_BUILD_COMMAND=
CEPH_PATCH_OUTPUT_DIR=
CEPH_PATCH_NODE_STAGING_DIR=/opt/ceph-aiops-patch-staging

# --- Worker ---
WORKER_MAX_RETRIES=3
WORKER_APPROVAL_POLL_INTERVAL_SECONDS=5

# --- API AI (Claude / Codex / OpenRouter / 9router tự triển khai) ---
# Để trống nếu chưa dùng tính năng chẩn đoán AI / Chat-with-AI — cấu hình
# sau qua trang Cài đặt cũng được (chọn loại kết nối rồi nhập key/model).
ROUTER_PROVIDER=9router
ROUTER_API_KEY=
ROUTER_BASE_URL=
ROUTER_MODEL=
ROUTER_ENABLED=false
CODEX_CHAT_ENABLED=false
CODEX_CHAT_MODEL=
# OAuth credentials are stored by Codex CLI below this private directory.
CODEX_HOME=.codex-account
CLAUDE_CHAT_ENABLED=false
CLAUDE_CHAT_MODEL=default
CLAUDE_CHAT_EFFORT=auto
# OAuth credentials are stored by Claude Code below this private directory.
CLAUDE_CONFIG_DIR=.claude-account
# --- AI Code Repair: planner/reviewer vs implementer ---
# Planner phân tích và review; Implementer sửa code và viết test.
# Supervisor vẫn chỉ chạy khi được gọi rõ ràng, không tự deploy production.
CODE_REPAIR_PLANNER_PROVIDER=codex
CODE_REPAIR_PLANNER_MODEL=
CODE_REPAIR_IMPLEMENTER_PROVIDER=codex
CODE_REPAIR_IMPLEMENTER_MODEL=
CODE_REPAIR_MAX_REVIEW_ROUNDS=2
# Read-only weekly Ceph operations digest via the incident Telegram channel.
AI_OPS_WEEKLY_DIGEST_ENABLED=true
AI_OPS_WEEKLY_DIGEST_DAY=mon
AI_OPS_WEEKLY_DIGEST_HOUR=8
AI_OPS_WEEKLY_DIGEST_MINUTE=0
# CPU/RAM forecast: samples are stored in and read back from Loki.
NODE_RESOURCE_FORECAST_ENABLED=false
# If true, Watcher samples /proc over SSH and pushes CPU/RAM JSON to Loki
# before each node-health scan. Leave false when Alloy already ships these
# samples from every node.
NODE_RESOURCE_LIVE_INGEST_ENABLED=false
NODE_RESOURCE_FORECAST_HISTORY_DAYS=30
NODE_RESOURCE_FORECAST_HORIZON_HOURS=168
NODE_RESOURCE_FORECAST_MIN_SAMPLES=24
NODE_RESOURCE_FORECAST_MIN_CONFIDENCE=0.5
NODE_RESOURCE_LEARNING_EVALUATION_HOURS=24
NODE_RESOURCE_LEARNING_MIN_OUTCOMES=3
NODE_RESOURCE_LEARNING_CANDIDATE_HOURS=24,72,168,720
NODE_RESOURCE_FORECAST_ALERT_COOLDOWN_SECONDS=86400
